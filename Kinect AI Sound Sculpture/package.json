{
  "name": "kinect-sound-sculpture",
  "version": "2.0.0",
  "description": "Interactive sound sculpture using Kinect motion tracking for multi-person collaborative audio-visual experiences",
  "main": "public/KinectSculptureApp.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/run-all-tests.js",
    "test:unit": "node tests/unit/movement-analysis.test.js",
    "test:integration": "node tests/integration/data-pipeline.test.js",
    "test:performance": "node tests/performance/multi-person-performance.test.js",
    "test:automated": "node tests/automated/recorded-data-tests.js",
    "test:load": "node tests/load/extended-operation.test.js",
    "test:parallel": "node tests/run-all-tests.js --parallel",
    "test:ci": "node tests/run-all-tests.js --exit-on-failure --no-html",
    "build": "echo 'Build step - copying production config' && cp public/config/production.json public/config/config.json",
    "build:dev": "echo 'Development build - copying dev config' && cp public/config/development.json public/config/config.json",
    "lint": "echo 'Linting JavaScript files...' && find public -name '*.js' -exec echo 'Checking {}' \\;",
    "validate": "node -c public/KinectSculptureApp.js && echo 'Main application syntax valid'",
    "docs": "echo 'Documentation generation not implemented'",
    "clean": "rm -rf tests/reports/* tests/data/recorded/* && echo 'Test artifacts cleaned'",
    "deploy": "npm run test:ci && npm run build && echo 'Ready for deployment'",
    "monitor": "node --inspect server.js",
    "profile": "node --prof server.js"
  },
  "keywords": [
    "kinect",
    "motion-tracking",
    "interactive-art",
    "sound-sculpture",
    "multi-person",
    "collaborative",
    "audio-visual",
    "installation",
    "museum",
    "real-time",
    "web-audio",
    "azure-kinect",
    "body-tracking",
    "websocket",
    "socket.io",
    "movement-analysis"
  ],
  "author": "Science Museum Oklahoma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/organization/kinect-sound-sculpture.git"
  },
  "bugs": {
    "url": "https://github.com/organization/kinect-sound-sculpture/issues"
  },
  "homepage": "https://github.com/organization/kinect-sound-sculpture#readme",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "ws": "^8.14.2",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.44.0",
    "prettier": "^3.0.0",
    "jsdoc": "^4.0.0"
  },
  "peerDependencies": {
    "kinect2": "^0.3.0"
  },
  "optionalDependencies": {
    "sharp": "^0.32.0",
    "canvas": "^2.11.0"
  },
  "config": {
    "port": 3000,
    "host": "localhost",
    "environment": "development"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "public/"
    ],
    "ext": "js,json,html,css",
    "ignore": [
      "tests/",
      "node_modules/",
      "*.log"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true,
      "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off",
      "prefer-const": "error"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none"
  },
  "directories": {
    "test": "tests",
    "doc": "docs",
    "lib": "public/core"
  },
  "files": [
    "public/",
    "server.js",
    "README.md",
    "package.json"
  ]
}